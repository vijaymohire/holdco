{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HoldCo QAI Environment Contract",
    "description": "Structural schema for a declarative QAI environment definition. It does not implement reference resolution, authorization, provider validation, environment provisioning, or runtime binding.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "api_version",
        "kind",
        "metadata",
        "spec"
    ],
    "properties": {
        "api_version": {
            "const": "holdco.qai/v1alpha1"
        },
        "kind": {
            "const": "Environment"
        },
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "namespace",
                "name",
                "stable_id",
                "version"
            ],
            "properties": {
                "namespace": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "stable_id": {
                    "type": "string",
                    "pattern": "^ENV-[0-9]{6}$"
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "spec": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "environment_type",
                "target_ref",
                "runtime"
            ],
            "properties": {
                "environment_type": {
                    "type": "string",
                    "enum": [
                        "dev",
                        "test",
                        "prod",
                        "other"
                    ]
                },
                "target_ref": {
                    "type": "string",
                    "minLength": 1
                },
                "runtime": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "mode"
                    ],
                    "properties": {
                        "mode": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "configuration_refs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "project": {
                            "type": "string",
                            "minLength": 1
                        },
                        "resource_profile": {
                            "type": "string",
                            "minLength": 1
                        },
                        "storage_profile": {
                            "type": "string",
                            "minLength": 1
                        },
                        "database_profile": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                }
            }
        }
    }
}
