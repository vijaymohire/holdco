# ============================================================
# HoldCo workspace - Git ignore rules
# ============================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter temporary files
.ipynb_checkpoints/

# Build / packaging output
build/
dist/
*.egg-info/

# Local environment / secrets
.env
.env.*
!.env.example

# IDE / editor metadata
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary / backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Local logs
*.log

# Generated reports / exports
# Add project-specific generated-output rules below when required.
